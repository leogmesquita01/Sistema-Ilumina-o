# Copie este arquivo para `.env` (mesma pasta) e preencha com as chaves reais.
# O `.env` está no .gitignore e NUNCA deve ser commitado.

# URL do projeto (não é segredo).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (`sb_publishable_...`) — usada só para LEITURA.
# Supabase -> Settings -> API Keys.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave secreta (`sb_secret_...`) — usada só para ESCRITA, no servidor.
# Ignora RLS: NUNCA vai para o navegador, para o código ou para o Git.
SUPABASE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
