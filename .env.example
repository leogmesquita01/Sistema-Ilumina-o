# Copie este arquivo para `.env` (mesma pasta) e preencha com os valores reais.
# O `.env` está no .gitignore e NUNCA deve ser commitado.

# URL do projeto (não é segredo).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (`sb_publishable_...`). O login de cada usuário usa esta chave;
# o que cada um pode ler/gravar é decidido pelo RLS (supabase/migrations/002_login.sql).
# Supabase -> Settings -> API Keys.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave secreta (`sb_secret_...`). O APP NÃO USA. Só para scripts de manutenção
# rodados na sua máquina. Pode deixar em branco. NUNCA vai para o Git.
SUPABASE_SECRET_KEY=

# Modo local: 1 = usa só o SQLite em data/, sem login e sem internet.
# Só para desenvolvimento. Em produção, deixe 0.
ILUMINA_MODO_LOCAL=0
